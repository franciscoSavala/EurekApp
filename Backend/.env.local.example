# Copiá este archivo como .env.local y completá los valores reales.
# .env.local NO se commitea (está en .gitignore).

# OpenAI — https://platform.openai.com/api-keys
OPENAI_SECRET_KEY=sk-...

# JWT — cualquier string largo y aleatorio (mínimo 32 caracteres)
JWT_SIGN_KEY=cambia-esto-por-un-string-largo-y-random-local

# Gmail SMTP — contraseña de aplicación (myaccount.google.com → Seguridad → Contraseñas de aplicaciones)
MAIL_USER=eurekapp.cba@gmail.com
MAIL_PASSWORD=tu-contrasena-de-aplicacion-gmail-sin-espacios

# AWS S3 ya NO hace falta acá: en local start-local.sh levanta MinIO (S3 local) con credenciales
# fijas definidas en application-local.yml. Esto solo es necesario si en algún momento querés que
# tu backend local apunte al S3 real de AWS en vez de a MinIO.
