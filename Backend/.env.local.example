# Copiá este archivo como .env.local y completá los valores reales.
# .env.local NO se commitea (está en .gitignore).

# OpenAI — https://platform.openai.com/api-keys
OPENAI_SECRET_KEY=sk-...

# JWT — cualquier string largo y aleatorio (mínimo 32 caracteres)
JWT_SIGN_KEY=cambia-esto-por-un-string-largo-y-random-local

# Gmail SMTP — contraseña de aplicación (myaccount.google.com → Seguridad → Contraseñas de aplicaciones)
MAIL_USER=eurekapp.cba@gmail.com
MAIL_PASSWORD=tu-contrasena-de-aplicacion-gmail-sin-espacios

# ── S3 local vs AWS real ───────────────────────────────────────────────────
# Por default (sin nada seteado acá) el backend local sube/lee fotos contra MinIO
# (docker-compose.yml, credenciales fijas minioadmin/minioadmin) — no hace falta ninguna
# cuenta de AWS para levantar el proyecto.
#
# Para que tu backend local apunte al S3 REAL de AWS en vez de a MinIO, descomentá estas
# tres lineas y completá con una Access Key real con permisos sobre el bucket "eurekapp-temp":
# S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=AKIA....
# AWS_SECRET_ACCESS_KEY=tu-secret-key-de-aws
