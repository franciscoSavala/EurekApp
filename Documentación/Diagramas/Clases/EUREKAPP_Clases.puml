@startuml
hide empty members
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontSize 11
skinparam nodesep 60
skinparam ranksep 90
title EurekApp: Diagrama de Clases del dominio

class UserEurekapp {
  -id : Long
  -username : String
  -password : String
  -active : boolean
  -firstName : String
  -lastName : String
  -role : Role
  -XP : Long
  -returnedObjects : Long
  -providerType : String
  -providerId : String
  -passwordResetToken : String
  -passwordResetTokenExpiry : LocalDateTime
  -fraudAlertsSeenAt : LocalDateTime
}

class Organization {
  -id : Long
  -name : String
  -contactData : String
  -street : String
  -streetNumber : String
  -city : String
  -province : String
  -country : String
  -organizationType : OrganizationType
  -coordinates : GeoCoordinates
  -active : boolean
}

class OrganizationPolicy {
  -id : Long
  -maxStorageDays : Integer
  -requiresIdentityValidation : Boolean
  -requiresAdditionalEvidence : Boolean
  -additionalEvidenceDetails : String
  -organizationType : OrganizationType
}

class OrganizationPolicyHistory {
  -id : Long
  -organizationId : Long
  -changedAt : LocalDateTime
  -previousSnapshot : String
}

class OrganizationRequest {
  -id : Long
  -organizationName : String
  -organizationType : OrganizationType
  -customOrganizationType : String
  -street : String
  -streetNumber : String
  -city : String
  -province : String
  -country : String
  -coordinates : GeoCoordinates
  -ownerFirstName : String
  -ownerLastName : String
  -ownerEmail : String
  -ownerPhone : String
  -reason : String
  -status : OrganizationRequestStatus
  -createdAt : LocalDateTime
  -resolvedAt : LocalDateTime
  -adminNote : String
}

class AddEmployeeRequest {
  -id : Long
  -status : AddEmployeeRequestStatus
}

class FoundObject {
  -uuid : String
  -imageEmbedding : List<Float>
  -textEmbedding : List<Float>
  -foundDate : LocalDateTime
  -title : String
  -humanDescription : String
  -organizationId : String
  -coordinates : GeoCoordinates
  -wasReturned : Boolean
  -category : String
  -score : Float
  -distance : Float
  -imageCertainty : Float
  -textCertainty : Float
}

class LostObject {
  -uuid : String
  -description : String
  -username : String
  -lostDate : LocalDateTime
  -organizationId : String
  -coordinates : GeoCoordinates
  -imageEmbedding : List<Float>
  -textEmbedding : List<Float>
  -category : String
  -score : Float
  -imageCertainty : Float
  -textCertainty : Float
  -status : LostObjectStatus
  -closedDate : LocalDateTime
  -recovered : Boolean
  -hasImage : Boolean
  -matchedObjectUuid : String
}

class ReturnFoundObject {
  -id : Long
  -firstName : String
  -lastName : String
  -DNI : String
  -phoneNumber : String
  -foundObjectUUID : String
  -personPhotoUUID : String
  -datetimeOfReturn : LocalDateTime
  -notificationSentAt : LocalDateTime
  -notificationRecipient : String
  -organizationId : Long
  -feedbackToken : String
}

class FraudAlert {
  -id : Long
  -organizationId : String
  -foundObjectUUID : String
  -dni : String
  -reason : String
  -details : String
  -status : FraudAlertStatus
  -createdAt : LocalDateTime
  -resolvedAt : LocalDateTime
  -dedupKey : String
}

class FraudBlock {
  -id : Long
  -targetDni : String
  -blockedAt : LocalDateTime
  -expiresAt : LocalDateTime
}

class FraudCaseMatch {
  -caseType : FraudCaseType
  -matchedCount : int
}

class FraudDetectionConfig {
  -id : Long
  -fraudThreshold : int
  -fraudWindowDays : int
  -blockDurationDays : int
}

class InAppNotification {
  -id : Long
  -title : String
  -description : String
  -type : String
  -read : boolean
  -createdAt : LocalDateTime
  -relatedRequestId : Long
  -relatedObjectUuid : String
  -matchScore : Double
  -relatedLostObjectUuid : String
}

class OrganizationFeedback {
  -id : Long
  -organizationId : Long
  -staffTreatment : Integer
  -waitingTime : Integer
  -instructionsClarity : Integer
  -objectCondition : Integer
  -pickupSecurity : Integer
  -comment : String
  -createdAt : LocalDateTime
}

class SearchFeedback {
  -id : Long
  -organizationId : String
  -foundObjectUUID : String
  -starRating : Integer
  -wasFound : Boolean
  -comment : String
  -lostObjectText : String
  -createdAt : LocalDateTime
}

class UsabilityFeedback {
  -id : Long
  -starRating : Integer
  -aspects : String
  -comment : String
  -context : String
  -createdAt : LocalDateTime
}

class RewardExclusion {
  -id : Long
  -foundObjectUUID : String
  -userRole : Role
  -reason : String
  -excludedAt : LocalDateTime
  -organizationId : String
}

class GeoCoordinates {
  -latitude : Double
  -longitude : Double
}

package "Tipos usados como atributos" {
enum Role {
  USER
  ORGANIZATION_OWNER
  ORGANIZATION_EMPLOYEE
  ENCARGADO
  ADMIN
}

enum OrganizationType {
  CLUB
  AIRPORT
  SHOPPING
  OTHER
  UNIVERSITY
  SCHOOL
  HOSPITAL
  HOTEL
  RESTAURANT
  BUS_TERMINAL
  TRAIN_STATION
  SPORTS_COMPLEX
  GYM
  CORPORATE_OFFICE
  COWORKING
  CINEMA
  THEATER
  STADIUM
  EVENT
  CITY_HALL
  LIBRARY
  MUSEUM
  CASINO
  RECREATIONAL_PARK
  CAMPING
  CRUISE_PORT
  CHURCH
  SUPERMARKET
  SHOPPING_MALL
  CONVENTION_CENTER
  AMUSEMENT_PARK
  PRIVATE_BEACH
}

enum OrganizationRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum AddEmployeeRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum FraudAlertStatus {
  ACTIVE
  FALSE_POSITIVE
}

enum FraudCaseType {
  CASE_1
  CASE_2
  CASE_3
}

enum LostObjectStatus {
  ACTIVE
  PENDING_PICKUP
  RETRIEVED
  RETRIEVED_BY_OTHER
  CLOSED
}

}

UserEurekapp "0..*" --> "0..1" Organization : organization
OrganizationPolicy "0..1" --> "0..1" Organization : organization
OrganizationPolicyHistory "0..*" --> "0..1" UserEurekapp : changedBy
OrganizationRequest "0..*" --> "1" UserEurekapp : requestingUser
OrganizationRequest "0..*" --> "0..1" UserEurekapp : resolvedBy
OrganizationRequest "0..*" --> "0..1" Organization : organization
AddEmployeeRequest "0..*" --> "1" UserEurekapp : user
AddEmployeeRequest "0..*" --> "1" Organization : organization
FoundObject "0..*" --> "0..1" UserEurekapp : objectFinderUser
ReturnFoundObject "0..*" --> "0..1" UserEurekapp : userEurekapp
ReturnFoundObject "0..*" --> "0..1" UserEurekapp : returnedByEmployee
FraudAlert "0..*" --> "0..*" UserEurekapp : suspectUsers
FraudAlert "0..*" --> "0..*" ReturnFoundObject : triggeringReturns
FraudAlert "0..*" --> "0..1" UserEurekapp : returnedByEmployee
FraudAlert "1" *-- "0..*" FraudCaseMatch : caseMatches
FraudAlert "0..*" --> "0..1" UserEurekapp : resolvedBy
FraudBlock "0..*" --> "0..1" UserEurekapp : targetUser
FraudBlock "0..*" --> "1" FraudAlert : fraudAlert
InAppNotification "0..*" --> "1" UserEurekapp : user
OrganizationFeedback "0..1" --> "1" ReturnFoundObject : returnFoundObject
OrganizationFeedback "0..*" --> "0..1" UserEurekapp : user
SearchFeedback "0..*" --> "0..1" UserEurekapp : user
UsabilityFeedback "0..*" --> "0..1" UserEurekapp : user
RewardExclusion "0..*" --> "1" UserEurekapp : user

@enduml
